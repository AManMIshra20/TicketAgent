# Copy to .env and fill in. Never commit .env.

# Optional. Without it the app runs in demo mode: the store, retrieval, the
# gate, the queue and the executor are all live; only the model's reasoning
# is replayed. With it, the real agent runs.
ANTHROPIC_API_KEY=

# The model. Set only here -- never hardcoded elsewhere.
AGENT_MODEL=claude-sonnet-5

# Where the SQLite database lives.
DB_PATH=data/meridian.db

# Seed for the synthetic corpus. The same seed always produces the same
# tickets, SOPs and planted defects.
SEED=42

# Optional GitHub adapter. Not needed for the local or deployed demo.
GITHUB_TOKEN=
GITHUB_REPO=
